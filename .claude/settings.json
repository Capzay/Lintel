{
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "lintel hook claude",
            "timeout": 15,
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "lintel hook claude",
            "timeout": 15,
            "type": "command"
          }
        ],
        "matcher": "Write|Edit|MultiEdit|Bash|PowerShell|NotebookEdit"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "lintel hook claude",
            "timeout": 15,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "lintel hook claude",
            "timeout": 15,
            "type": "command"
          }
        ]
      }
    ]
  }
}
