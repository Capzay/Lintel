{
  "hooks": {
    "AfterAgent": [
      {
        "hooks": [
          {
            "command": "lintel hook gemini",
            "name": "lintel",
            "timeout": 10000,
            "type": "command"
          }
        ]
      }
    ],
    "BeforeTool": [
      {
        "hooks": [
          {
            "command": "lintel hook gemini",
            "name": "lintel",
            "timeout": 10000,
            "type": "command"
          }
        ],
        "matcher": "write_file|replace|run_shell_command|shell"
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "command": "lintel hook gemini",
            "name": "lintel",
            "timeout": 10000,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "lintel hook gemini",
            "name": "lintel",
            "timeout": 10000,
            "type": "command"
          }
        ]
      }
    ]
  }
}
