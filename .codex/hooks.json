{
  "description": "Jev change gate. Trust this hook with /hooks before Codex will run it.",
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "lintel hook codex",
            "statusMessage": "Checking Lintel",
            "timeout": 15,
            "type": "command"
          }
        ],
        "matcher": "Bash|apply_patch|Edit|Write"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "lintel hook codex",
            "timeout": 15,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "lintel hook codex",
            "timeout": 15,
            "type": "command"
          }
        ]
      }
    ]
  }
}
